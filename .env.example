# Copy to .env and fill in real values before running docker compose.
# Never commit the real .env file.

# --- PostgreSQL ---
POSTGRES_USER=tatkal
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tatkal

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=tatkal
RABBITMQ_DEFAULT_PASS=change_me

# --- JWT ---
JWT_SIGNING_KEY=change_me_to_a_long_random_string
JWT_ISSUER=tatkal-booking-system
JWT_AUDIENCE=tatkal-clients

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me
